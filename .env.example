# Environment Variables for Binti Events Frontend Client

# API Base URL for Production (Set this in Vercel Dashboard -> Settings -> Environment Variables)
# Points to your Supabase Edge Functions (the sole auth + data authority)
VITE_API_URL=https://ltinjyvcrgwcvudrnfby.supabase.co/functions/v1

# Supabase Anon Key (used for the apikey header on Edge Function requests)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Application Branding Title
VITE_APP_NAME=Binti Events Management System